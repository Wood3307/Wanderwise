# Optional. Keep this server-side; never use a VITE_ prefix for secrets.
# Obtain an Access Secret from https://developer.zhihu.com/profile
# Without a secret, Wanderwise browses the official hackathon public knowledge corpus.
ZHIHU_ACCESS_SECRET=

# Optional small model for selecting source-grounded highlights. No model is required:
# the built-in extractor always returns verbatim source passages, with paragraph indexes.
# A compatible endpoint takes precedence. HTTP is allowed only for local endpoints.
# Example for an already-installed Ollama model:
# MODEL_BASE_URL=http://127.0.0.1:11434/v1
# MODEL_NAME=qwen3:4b
# MODEL_API_KEY=

# Or enable the documented Zhihu fast model with the Access Secret above.
# This sends only the selected article's bounded excerpt to Zhihu and consumes model quota.
ZHIHU_MODEL_ENABLED=false

# Express API and production web server. Vite development proxy expects port 3001.
PORT=3001
